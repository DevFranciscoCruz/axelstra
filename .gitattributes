# Source is LF in the repo and in the working tree on every platform (prettier, rustfmt and the checks assume it).
* text=auto eol=lf
*.sh text eol=lf
# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
# binaries
*.png binary
*.gif binary
*.ico binary
*.icns binary
