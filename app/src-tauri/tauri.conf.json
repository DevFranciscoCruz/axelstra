{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axelstra",
  "version": "0.1.0",
  "identifier": "dev.axelstra.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Axelstra",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RjlFMjJFNEZDNjdBOTAKUldTUWVzWlBMdUw1dHFKYW9MQWM5Q3ZtSDArSWpYVkpFSzErSjRRN2VQUEVMVldtcUpDZU1ud1oK",
      "endpoints": [
        "https://github.com/DevFranciscoCruz/axelstra/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
