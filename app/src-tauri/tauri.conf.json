{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axelstra",
  "version": "0.1.0",
  "identifier": "dev.axelstra.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Axelstra", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
